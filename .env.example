# API Configuration (LiteLLM / OpenAI Compatible)
OPENAI_BASE_URL="http://your-llm-server-address:port/v1" # e.g. the borges url
OPENAI_API_KEY="your_api_key_here" # token-not-required
MODEL_ID="your-model-id"  # e.g. ilsp/Llama-Krikri-8B-Instruct-v1.5

# Grader / Judge Model Configuration
GRADER_BASE_URL="http://your-grader-server-address:port/v1"
GRADER_API_KEY="your_grader_api_key_here"
GRADER_MODEL_ID="your-grader-model-id"

# Hugging Face Repository Configuration
HF_REPO_ID="ilsp/greek-protipa-exams"
HF_TOKEN="your_hf_token_here"
HF_PRIVATE_REPO=False
HF_GATED_REPO=manual

# Local Data Paths 
PROTIPA_LOCAL_DATA_DIR=./data
PROTIPA_EVAL_DATA_PATH=./results/full_dataset_for_eval_open.json


